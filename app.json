{
  "name": "WakuMusic",
  "description": "Discord music bot using a remote Lavalink node and MongoDB Atlas.",
  "repository": "https://github.com/takeshi7502/waku-musicbot",
  "logo": "https://cdn.discordapp.com/avatars/750613142488481843/e6326038dbe2243ca551ba5b6ecd8bf2.png?size=1024",
  "keywords": [
    "node",
    "discord",
    "youtube",
    "music",
    "bot",
    "lavalink",
    "dashboard"
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "DISCORD_TOKEN": {
      "description": "The Discord Bot Token (https://discord.com/developers/applications)",
      "required": true
    },
    "DISCORD_CLIENT_ID": {
      "description": "The Discord Bot ClientID",
      "required": true
    },
    "BOT_ADMIN_ID": {
      "description": "Discord user ID allowed to use bot administration commands",
      "required": true
    },
    "MONGODB_URI": {
      "description": "MongoDB Atlas connection string. Required because Heroku dyno storage is temporary.",
      "required": true
    },
    "LAVALINK_HOST": {
      "description": "Public TLS hostname of the Lavalink reverse proxy, for example node.lavalink.example.com",
      "required": true
    },
    "LAVALINK_PASSWORD": {
      "description": "Lavalink server password",
      "required": true
    },
    "LAVALINK_PORT": {
      "description": "Lavalink TLS port",
      "value": "443"
    },
    "LAVALINK_SECURE": {
      "description": "Use HTTPS/WSS to reach Lavalink",
      "value": "true"
    },
    "BOT_LANGUAGE": {
      "description": "Default bot language",
      "value": "vi"
    }
  }
}
